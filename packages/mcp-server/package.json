{
  "name": "@specpilot/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP do SpecPilot: tools e resources para IDEs e agentes operarem o backlog e consultarem a arquitetura.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "specpilot-mcp": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx --conditions=@specpilot/source src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --conditions=@specpilot/source --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@specpilot/shared-schemas": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@specpilot/api": "workspace:*"
  }
}
